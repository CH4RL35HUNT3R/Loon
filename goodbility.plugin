#!name=Goodbility解锁
#!desc=GoodNotes & Notability 会员解锁（还原自 ddgksf2013）
#!author=ddgksf2013
#!openUrl=https://t.me/ddgksf2021

[Mitm]
hostname = isi.csan.*, notability.com

[Script]
http-response ^https?://notability\.com/global script-path=https://raw.githubusercontent.com/CH4RL35HUNT3R/Loon/main/goodbility.js, requires-body=true, tag=Goodbility-Notability
http-response ^https://isi\.csan\.[a-z.]+\/.+\/(receipts$|subscribers\/[^/]+$) script-path=https://raw.githubusercontent.com/CH4RL35HUNT3R/Loon/main/goodbility.js, requires-body=true, tag=Goodbility-GoodNotes
http-request ^https://isi\.csan\.[a-z.]+\/.+\/(receipts|subscribers) script-path=https://raw.githubusercontent.com/CH4RL35HUNT3R/Loon/main/goodbility.js, tag=Goodbility-Header
